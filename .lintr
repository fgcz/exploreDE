linters: linters_with_defaults(line_length_linter(120), cyclocomp_linter(15L), brace_linter = NULL, commas_linter = NULL, indentation_linter = NULL, infix_spaces_linter = NULL, object_length_linter(40), object_name_linter = NULL, paren_body_linter = NULL, return_linter = NULL, spaces_inside_linter = NULL, spaces_left_parentheses_linter = NULL, trailing_blank_lines_linter = NULL, trailing_whitespace_linter = NULL, undesirable_operator_linter(op = c("<<-" = "return the value (BiocCheck flags <<-)")), undesirable_function_linter(fun = c(suppressWarnings = "a handler for the one expected warning (BiocCheck flags suppressWarnings)", suppressMessages = "a quiet argument, or no message (BiocCheck flags suppressMessages)")))
# undesirable_*: what BiocCheck flags as notes. inst/app is excluded: its server-*.R files run in one shared environment, which object_usage_linter cannot see
exclusions: list("inst/doc", "tests/testthat", "vignettes", "inst/app")
